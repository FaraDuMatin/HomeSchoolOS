// HomeSchoolOs — schéma minimal.
//
// Une règle gouverne tout ce fichier : rien de ce qui finit dans le bilan du
// ministère n'est saisi par un humain. La présence vient d'événements, la
// progression vient d'exercices réellement complétés, et les traces datées
// viennent des séances. Un bilan est une lecture de ces tables, jamais une
// rédaction.

generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// --- Personnes ---------------------------------------------------------------

// INSTRUCTOR enseigne. SUPERVISOR est l'enseignant breveté qui encadre quatre
// instructeurs. MANAGER voit le remplissage et la viabilité. PARENT reste
// l'éducateur légal de son enfant : rien dans ce schéma ne lui retire ce rôle.
enum Role {
  INSTRUCTOR
  SUPERVISOR
  MANAGER
  PARENT
  STUDENT
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  role      Role     @default(STUDENT)
  createdAt DateTime @default(now())

  // Un élève a un parent. Un parent a plusieurs enfants.
  parentId String?
  parent   User?   @relation("ParentChild", fields: [parentId], references: [id])
  children User[]  @relation("ParentChild")

  // L'instructeur d'une cohorte, et le superviseur qui l'encadre.
  cohortsTaught    Cohort[] @relation("CohortInstructor")
  cohortsSupervised Cohort[] @relation("CohortSupervisor")

  memberships CohortMember[]
  attendance  Attendance[]
  attempts    ExerciseAttempt[]

  complianceTasks ComplianceTask[]
  consent         RecordingConsent?
  privacyEvents   PrivacyEvent[]
  transcriptSaid  TranscriptSegment[]
}

// --- Cohorte -----------------------------------------------------------------

// LE PLAFOND DE 4 EST LA LOI, PAS UNE PRÉFÉRENCE.
//
// La Loi sur l'enseignement privé (E-9.1) exempte de permis une personne
// physique qui enseigne SEULE à MOINS DE CINQ élèves à la fois, à condition que
// ces élèves remplissent autrement leur obligation de fréquentation — ce que
// fait l'enseignement à la maison.
//
// Un cinquième élève dans la même salle avec le même instructeur fait de ce
// centre un établissement d'enseignement privé : permis du ministère via ETAPE,
// inscription GDUNO, programme complet, et demande déposée au plus tard le
// 1er septembre de l'année PRÉCÉDENTE. Douze mois d'avance.
//
// SQLite ne peut pas exprimer cette contrainte, donc elle vit dans
// app/lib/cohort.ts et toute écriture doit passer par là.
model Cohort {
  id        String   @id @default(cuid())
  name      String
  language  String   @default("FR") // "FR" ou "EN"
  gradeBand String // ex. "Primaire 3-4"
  createdAt DateTime @default(now())

  instructorId String
  instructor   User   @relation("CohortInstructor", fields: [instructorId], references: [id])

  supervisorId String?
  supervisor   User?   @relation("CohortSupervisor", fields: [supervisorId], references: [id])

  members  CohortMember[]
  sessions Session[]
}

model CohortMember {
  id       String   @id @default(cuid())
  cohortId String
  cohort   Cohort   @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  studentId String
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  joinedAt  DateTime @default(now())

  @@unique([cohortId, studentId])
}

// --- Séance ------------------------------------------------------------------

enum SessionStatus {
  SCHEDULED
  LIVE
  ENDED
}

model Session {
  id       String        @id @default(cuid())
  cohortId String
  cohort   Cohort        @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  status   SessionStatus @default(SCHEDULED)
  subject  String // français, anglais, mathématiques, science, univers social
  plannedAt DateTime

  // Projection des événements, jamais écrite depuis un formulaire.
  startedAt       DateTime?
  endedAt         DateTime?
  durationSeconds Int?

  attendance Attendance[]
  attempts   ExerciseAttempt[]
  transcript TranscriptSegment[]
  events     SessionEvent[]
}

// Journal append-only. C'est la source de vérité de la présence : le bilan
// remis au ministère ne repose pas sur ce qu'un tuteur affirme, mais sur ce que
// le système a observé.
model SessionEvent {
  id        String   @id @default(cuid())
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  type      String // SESSION_STARTED, SESSION_ENDED, STUDENT_PRESENT, STUDENT_ABSENT
  actorId   String?
  payload   String? // JSON sérialisé
  occurredAt DateTime @default(now())

  @@index([sessionId, occurredAt])
}

model Attendance {
  id        String   @id @default(cuid())
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentId String
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  present   Boolean  @default(false)
  minutes   Int      @default(0)

  @@unique([sessionId, studentId])
}

// --- Programme ---------------------------------------------------------------

// competency porte le code du Programme de formation de l'école québécoise.
// C'est lui qui rend le bilan acceptable : la DEM renvoie les bilans qui ne
// couvrent pas toutes les compétences d'une matière.
model Exercise {
  id         String @id @default(cuid())
  title      String
  subject    String
  competency String
  prompt     String

  attempts ExerciseAttempt[]
}

model ExerciseAttempt {
  id         String   @id @default(cuid())
  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  studentId  String
  student    User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  sessionId  String?
  session    Session? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  completed  Boolean  @default(false)
  answer     String?
  completedAt DateTime @default(now())

  @@index([studentId, completedAt])
}

// --- Transcription -----------------------------------------------------------

// Voix de mineurs. La Loi 25 s'applique : consentement parental avant tout
// enregistrement, conservation limitée, et le parent peut tout supprimer.
model TranscriptSegment {
  id        String   @id @default(cuid())
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  speaker   String // "instructor" ou "student"

  // Sans ce lien, le droit a l'effacement de la Loi 25 est intenable : on ne
  // peut pas supprimer les paroles d'un enfant si on ne sait pas lesquelles
  // sont les siennes. Nullable parce que la voix de l'instructeur n'appartient
  // a aucun eleve.
  studentId String?
  student   User?   @relation(fields: [studentId], references: [id], onDelete: SetNull)

  text      String
  startsAtMs Int
  createdAt DateTime @default(now())

  @@index([sessionId, startsAtMs])
}

// --- Conformité --------------------------------------------------------------

// Les sept obligations du régime d'enseignement à la maison.
//
// Les DATES ne sont pas ici. Elles sont fixées par le Règlement sur
// l'enseignement à la maison, elles sont les mêmes pour toutes les familles du
// Québec, et une date recopiée dans une base de données est une date qu'on peut
// se tromper en modifiant. Elles vivent dans app/lib/compliance.ts, où elles
// sont calculées à partir de l'année scolaire.
//
// Cette table ne retient donc qu'une chose : est-ce que cette famille l'a fait,
// et quand. Le statut en retard, à venir ou fait est déduit de completedAt et de
// la date d'aujourd'hui, jamais stocké.
model ComplianceTask {
  id          String    @id @default(cuid())
  studentId   String
  student     User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  key         String // avis, projet, etat-situation, suivi, bilan-mi, epreuves, bilan-final, evaluateur
  schoolYear  String // "2026-2027"
  completedAt DateTime?
  note        String?

  @@unique([studentId, key, schoolYear])
  @@index([studentId, schoolYear])
}

// --- Loi 25 ------------------------------------------------------------------

// Consentement parental à l'enregistrement de la voix d'un mineur.
//
// La Loi 25 exige un consentement libre et éclairé, donné par le titulaire de
// l'autorité parentale pour un enfant de moins de 14 ans, pour une finalité
// précise, et retirable en tout temps. Le défaut est donc FALSE : tant qu'un
// parent n'a rien décidé, aucun enregistrement n'est permis.
//
// retentionDays porte la durée de conservation. La loi n'impose pas un nombre,
// elle impose de la fixer, de l'annoncer et de la respecter. Le nombre est donc
// une décision d'affaires, et il est modifiable par le parent vers le bas.
model RecordingConsent {
  id            String   @id @default(cuid())
  studentId     String   @unique
  student       User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  granted       Boolean  @default(false)
  retentionDays Int      @default(90)
  decidedAt     DateTime @default(now())
}

// Journal des gestes de confidentialité.
//
// Un bouton « supprimer » sans trace est invérifiable : le parent doit croire
// sur parole que quelque chose s'est passé. Chaque geste écrit une ligne ici, et
// cette ligne survit à la suppression des données qu'elle décrit.
model PrivacyEvent {
  id         String   @id @default(cuid())
  studentId  String
  student    User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  type       String // CONSENT_GRANTED, CONSENT_REVOKED, RETENTION_CHANGED, TRANSCRIPTS_DELETED, RETENTION_PURGE
  detail     String?
  occurredAt DateTime @default(now())

  @@index([studentId, occurredAt])
}
